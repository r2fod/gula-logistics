# Puerto del servidor
PORT=5000

# URI de conexión a MongoDB Atlas (Mantener privado en tu archivo .env local y en las variables de entorno de producción)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/gula_logistics?retryWrites=true&w=majority

# Secreto usado para firmar los tokens de sesión de administrador (HMAC).
# Genera uno único y aleatorio en producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=<genera-un-secreto-aleatorio-largo>

# Contraseña de administrador SOLO para el primer arranque (bootstrap).
# Se usa una única vez para crear el hash en MongoDB (colección AdminConfig);
# después, cámbiala desde el propio panel de administración — ya no se lee
# más este valor si el documento existe en MongoDB.
ADMIN_BOOTSTRAP_PASSWORD=<contraseña-inicial-solo-para-el-primer-arranque>

VAPID_PUBLIC_KEY=<tu-clave-publica-vapid>
VAPID_PRIVATE_KEY=<tu-clave-privada-vapid>
VAPID_SUBJECT=mailto:info@gulalogistics.com
